# Leave everything unset to run against the bundled mock servers (one per profile).

# --- Target a provider sandbox instead of the mock -------------------------
# Origin only (no path); paths come from the profile.
# SNAP_BASE_URL=https://sandbox.example.co.id
# Expected provider behaviour: a profile name from profiles/ (bri, bca, default) or a path to a .yaml file.
# SNAP_PROFILE=bri

# Credentials issued by the provider. Never commit real values.
# SNAP_CLIENT_KEY=
# SNAP_CLIENT_SECRET=
# SNAP_PARTNER_ID=
# SNAP_CHANNEL_ID=
# SNAP_PRIVATE_KEY_PATH=/secure/path/private.pem

# Accounts that exist in the sandbox (and one that does not).
# SNAP_TEST_SOURCE_ACCOUNT=
# SNAP_TEST_BENEFICIARY_ACCOUNT=
# SNAP_TEST_UNKNOWN_ACCOUNT=

# --- Mock server (npm run mock:start) ---------------------------------------
# MOCK_HOST=127.0.0.1
# MOCK_PORT=4010
# MOCK_PROFILE=default
# LOG_LEVEL=info
# TOKEN_TTL_SECONDS=900
# Max difference between X-TIMESTAMP and server time; 0 disables replay protection.
# TIMESTAMP_TOLERANCE_SECONDS=300
# Fault injection timing (X-SNAPCHECK-FAULT header): late answer, and how long "pending" lasts.
# MOCK_FAULT_DELAY_MS=3000
# MOCK_PENDING_SETTLE_MS=1000
# Where to send signed settlement notifications (e.g. the inbox below).
# MOCK_NOTIFICATION_URL=http://127.0.0.1:4100/snap/notify

# --- Notification inbox (snapcheck inbox) -----------------------------------
# INBOX_HOST=127.0.0.1
# INBOX_PORT=4100
# INBOX_PATH=/snap/notify
